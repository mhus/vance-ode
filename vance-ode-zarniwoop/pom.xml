<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.mhus.vance.ode</groupId>
        <artifactId>vance-ode</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>vance-ode-zarniwoop</artifactId>
    <name>vance-ode-zarniwoop</name>
    <description>Answers Vancetope research queries out of this application's own index. Implement one interface, get the REST contract. Inbound, like vance-ode-centauri, and independent of it — searching and being read are different acts.</description>
    <packaging>jar</packaging>

    <dependencies>
        <!--
            Core is here for de.mhus.vance.ode.inbound alone — the shared-secret
            guard and the error body. Nothing outbound comes with it: core's
            auto-configuration is conditional on `vance.ode.base-url`, so a
            search source that sets no brain URL gets no client and no transport.
        -->
        <dependency>
            <groupId>de.mhus.vance.ode</groupId>
            <artifactId>vance-ode-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            No dependency on vance-ode-centauri. The two modules share a shape,
            not a contract: an application may implement both interfaces, and
            many will, but a search index has no chronology to page through.
            Coupling them would make every feed source carry a search endpoint
            it does not serve.
        -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            spring-webmvc rather than spring-boot-starter-web: the starter picks
            a servlet container and a logging implementation, and an application
            that already serves HTTP has made both choices. We need the
            annotations and the handler mapping, nothing else.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
