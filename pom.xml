<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.mhus.vance.ode</groupId>
    <artifactId>vance-ode</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <name>vance-ode</name>
    <description>Spring Boot library that connects foreign software to Vancetope. One module per Vancetope subsystem the application takes part in — a consumer depends on the contracts it uses and inherits nothing else.</description>
    <url>https://github.com/mhus/vance-ode</url>
    <packaging>pom</packaging>
    <inceptionYear>2026</inceptionYear>

    <!--
        Declared here rather than only in LICENSE so it travels with the
        published artifact: dependency scanners and Maven Central read
        this block, not the repository.
    -->
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!--
        url, scm and developers are not decoration: Maven Central rejects a
        deployment that omits any of them. They are inherited by the modules,
        so this block appears once.
    -->
    <scm>
        <url>https://github.com/mhus/vance-ode</url>
        <connection>scm:git:https://github.com/mhus/vance-ode.git</connection>
        <developerConnection>scm:git:git@github.com:mhus/vance-ode.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <developers>
        <developer>
            <id>mhu</id>
            <name>Mike Hummel</name>
            <email>mh@mhus.de</email>
            <url>http://www.mhus.de</url>
        </developer>
    </developers>

    <modules>
        <module>vance-ode-core</module>
        <module>vance-ode-ursa</module>
        <module>vance-ode-centauri</module>
        <module>vance-ode-zarniwoop</module>
        <module>vance-ode-jaglan</module>
    </modules>

    <properties>
        <!--
            Java 21, not 25 as in vance and hrafnagud. This is a library
            meant to be embedded in software we do not control, and the
            current LTS is the floor a consumer can be expected to meet.
            Nothing here needs a newer language level.
        -->
        <maven.compiler.release>21</maven.compiler.release>
        <spring.boot.version>4.1.0</spring.boot.version>
        <lombok.version>1.18.46</lombok.version>
        <jspecify.version>1.0.1</jspecify.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                BOM import rather than inheriting spring-boot-starter-parent.
                A library should not push a parent onto the poms that consume
                it; importing the BOM pins our own dependency versions without
                reaching into anyone else's build.
            -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.jspecify</groupId>
                <artifactId>jspecify</artifactId>
                <version>${jspecify.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                        spring-boot-starter-parent sets this for everyone; we
                        import the BOM instead and so have to set it ourselves.
                        Without it Spring cannot resolve parameter names, and
                        every @RequestParam/@PathVariable that does not repeat
                        its own name in the annotation fails at runtime with
                        "parameter name information not available".
                    -->
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>dependency-jar-properties</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Mockito's inline mock-maker needs the agent passed at
                         JVM start; self-attaching is deprecated for removal. -->
                    <argLine>-javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Everything Maven Central demands beyond a normal build, in one
            profile that the day-to-day build never activates: sources jar,
            javadoc jar, GPG signature, and the upload to the Central Portal.
            Driven by `wb ode release` — see readme/release.md.

            One profile rather than the deploy/release pair the other mhus
            repos use: there is no snapshot lane here (consumers build ode
            from source or take a release), so splitting "attach artifacts"
            from "sign them" would only give us a combination we never run.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.10.1</version>
                        <configuration>
                            <!--
                                Central requires the javadoc jar to exist, not
                                to be flawless. A doclint complaint in a
                                comment must not be able to abort a release
                                that is otherwise ready to go out.
                            -->
                            <failOnError>false</failOnError>
                            <doclint>none</doclint>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!--
                        Replaces distributionManagement entirely: with
                        extensions=true the plugin takes over the deploy phase
                        and uploads a bundle to the Central Portal. Credentials
                        come from the <server id=central> entry in
                        ~/.m2/settings.xml (portal user token, not the account
                        password).

                        autoPublish=true so a release does not sit in the
                        portal waiting for a click; waitUntil=validated returns
                        as soon as Central has accepted the bundle — the
                        publishing itself then runs on their side, and blocking
                        the terminal for it buys nothing we would act on.
                    -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.8.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
