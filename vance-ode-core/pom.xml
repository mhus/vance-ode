<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.mhus.vance.ode</groupId>
        <artifactId>vance-ode</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>vance-ode-core</artifactId>
    <name>vance-ode-core</name>
    <description>Shared by both directions: connection configuration, error model, HTTP transport, and the little that every inbound endpoint needs (shared-secret guard, error body). Its Spring Web dependencies are provided-scoped and therefore not transitive, so a consumer that only talks outbound still inherits no servlet stack. No controller lives here — that is what would break the promise.</description>
    <packaging>jar</packaging>

    <dependencies>
        <!--
            spring-boot-autoconfigure, not spring-boot-starter: the starter
            drags a logging implementation, which is the consumer's choice
            to make, not ours.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Jackson 3 (`tools.jackson.*`). This pins vance-ode to Spring
            Boot 4, which is deliberate: Boot 4 registers a Jackson 3
            ObjectMapper, and carrying both generations to stay compatible
            with Boot 3 would push the version conflict onto the consumer.
        -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!--
            For de.mhus.vance.ode.inbound only, and both `provided`: the
            shared-secret guard that every inbound module needs is a
            HandlerInterceptor, so it cannot be written without these types.
            Provided scope is not transitive, which is the whole point — an
            application that only fires events downloads nothing from here and
            the outbound-only case stays as lean as before. What must not move
            in is a controller: that would drag a servlet container into it,
            and then the promise really would be broken.

            The alternative was one copy of the guard per inbound module. A
            duplicated authentication check drifts, and the sibling repo made
            the same call for the same reason (vance-shared carries one shared
            filter base with provided-scoped Spring Web and nothing else
            web-shaped).
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
