<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.mhus.vance.ode</groupId>
        <artifactId>vance-ode</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>vance-ode-core</artifactId>
    <name>vance-ode-core</name>
    <description>Shared by both directions: connection configuration, error model, HTTP transport. Deliberately free of Spring Web so a consumer that only talks outbound does not inherit a servlet stack.</description>
    <packaging>jar</packaging>

    <dependencies>
        <!--
            spring-boot-autoconfigure, not spring-boot-starter: the starter
            drags a logging implementation, which is the consumer's choice
            to make, not ours.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Jackson 3 (`tools.jackson.*`). This pins vance-ode to Spring
            Boot 4, which is deliberate: Boot 4 registers a Jackson 3
            ObjectMapper, and carrying both generations to stay compatible
            with Boot 3 would push the version conflict onto the consumer.
        -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
